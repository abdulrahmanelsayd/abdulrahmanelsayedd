{
  "name": "abdulrahman-portfolio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.20.0 <25",
    "npm": ">=11.19.0 <12"
  },
  "packageManager": "npm@11.19.0",
  "scripts": {
    "dev": "next dev",
    "build": "node tools/next-guard.mjs build",
    "start": "next start",
    "typegen": "node tools/next-guard.mjs typegen",
    "typecheck": "npm run typegen && tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "node --test tests/unit/*.test.ts",
    "test:e2e": "playwright test",
    "test:release": "node tools/release-check.mjs",
    "test:regression": "playwright test --config playwright.regression.config.ts",
    "check:install": "node tools/check-install.mjs",
    "test:gallery": "node tools/gallery-smoke.mjs"
  },
  "dependencies": {
    "lenis": "1.3.26",
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.8",
    "sharp": "0.35.5",
    "typescript": "6.0.3"
  }
}
